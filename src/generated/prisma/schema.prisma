// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

model Utilisateur {
  id         Int             @id @default(autoincrement())
  nom        String          @db.VarChar(100)
  prenom     String          @db.VarChar(100)
  email      String          @unique @db.VarChar(100)
  motdepasse String
  role       RoleUtilisateur @default(personnelInterne)
  createdAt  DateTime        @default(now())
  updateAt   DateTime        @updatedAt

  emprunts                Emprunt[]
  demandeEmprunt          DemandeEmprunt[]
  utilisationsConsommable UtilisationConsommable[]
}

model Emprunt {
  id                  Int       @id @default(autoincrement())
  utilisateurId       Int
  equipementId        Int
  dateEmprunt         DateTime  @default(now())
  dateRetourPrevu     DateTime
  dateRetourEffective DateTime?
  usage               String
  statut              Statut    @default(EnCours)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  utilisateur  Utilisateur    @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  equipement   Equipement     @relation(fields: [equipementId], references: [id], onDelete: Cascade)
  notification Notification[]
}

model DemandeEmprunt {
  id              Int           @id @default(autoincrement())
  utilisateurId   Int
  equipementId    Int
  dateDemande     DateTime      @default(now())
  dateRetourPrevu DateTime
  usage           String
  statut          StatutDemande @default(enAttente)
  type            TypeDemande   @default(EMPRUNT)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  utilisateur  Utilisateur    @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  equipement   Equipement     @relation(fields: [equipementId], references: [id], onDelete: Cascade)
  notification Notification[]
}

model Equipement {
  id            Int           @id @default(autoincrement())
  nom           String        @db.VarChar(30)
  numeroDeSerie String        @db.VarChar(30)
  marque        String        @db.VarChar(30)
  disponibilite Disponibilite @default(Disponible)
  etatMateriel  EtatMateriel  @default(Neuf)
  obtention     Obtention     @default(Achat)
  prix          Float
  fournisseur   String?
  donateur      String?
  photo         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  emprunt        Emprunt[]
  demandeEmprunt DemandeEmprunt[]
}

model Notification {
  id               Int              @id @default(autoincrement())
  empruntId        Int?
  demandeEmpruntId Int?
  consommableId    Int?
  message          String
  DateEnvoi        DateTime         @default(now())
  type             TypeNotification @default(AlerteStock)
  vu               Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  emprunt        Emprunt?        @relation(fields: [empruntId], references: [id], onDelete: Cascade)
  demandeEmprunt DemandeEmprunt? @relation(fields: [demandeEmpruntId], references: [id])
  consommable    Consommable?    @relation(fields: [consommableId], references: [id], onDelete: Cascade)
}

model Consommable {
  id                 Int       @id @default(autoincrement())
  nom                String    @db.VarChar(30)
  quantiteDisponible Int
  seuilCritique      Int
  obtention          Obtention @default(Achat)
  fournisseur        String?
  donnateur          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  notification            Notification[]
  utilisationsConsommable UtilisationConsommable[]
}

model UtilisationConsommable {
  id              Int      @id @default(autoincrement())
  utilisateurId   Int
  consommableId   Int
  quantiteUtilise Int
  dateUtilisation DateTime @default(now())
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id])
  consommable Consommable @relation(fields: [consommableId], references: [id])
}

model Rapport {
  id        Int      @id @default(autoincrement())
  contenu   String
  periode   Periode  @default(Mensuel)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Obtention {
  Achat
  Don
}

enum Periode {
  Mensuel
  Hebdo
}

enum TypeNotification {
  AlerteStock
  RappelRetour
  Acceptation
  Refus
}

enum Statut {
  EnCours
  EnRetard
  Retourner
  EnAttente
}

enum Disponibilite {
  Disponible
  Emprunte
  EnMaintenance
  Indisponible
}

enum EtatMateriel {
  Neuf
  BonEtat
  EtatMoyen
  MauvaisEtat
  HorsUsage
  EnReparation
}

enum RoleUtilisateur {
  admin
  regisseurEquipementInterne
  client
  partenaire
  personnelInterne
}

enum StatutDemande {
  enAttente
  approuver
  refuser
}

enum TypeDemande {
  EMPRUNT
  RETOUR
}
